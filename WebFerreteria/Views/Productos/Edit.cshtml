@model WebFerreteria.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Editar Producto</h1>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- NOMBRE -->
            <div class="form-group">
                <label class="control-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <!-- PRECIO -->
            <div class="form-group">
                <label class="control-label">Precio</label>
                <input asp-for="Precio" type="number" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <!-- STOCK -->
            <div class="form-group">
                <label class="control-label">Stock</label>
                <input asp-for="Stock" type="number" class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <!-- CANTIDAD MEDIDA -->
            <div class="form-group">
                <label class="control-label">Cantidad Medida</label>
                <input asp-for="CantidadMedida" class="form-control" />
                <span asp-validation-for="CantidadMedida" class="text-danger"></span>
            </div>

            <!-- FECHA DE VENCIMIENTO -->
            <div class="form-group">
                <label class="control-label">Fecha de Vencimiento</label>
                <input asp-for="FechaVencimiento" type="date" class="form-control" />
                <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
            </div>

            <!-- MARCA -->
            <div class="form-group d-flex align-items-center">
                <div style="flex:1;">
                    <label class="control-label">Marca</label>
                    <select asp-for="IdMarca" class="form-select" asp-items="ViewBag.IdMarca">
                        <option disabled selected value="">Seleccione una marca</option>
                    </select>
                    <span asp-validation-for="IdMarca" class="text-danger"></span>
                </div>
                <div style="margin-left:10px; margin-top:30px;">
                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#nuevaMarcaModal">
                        <i class="fa fa-plus"></i> Nueva Marca
                    </button>
                </div>
            </div>

            <!-- CATEGORÍA -->
            <div class="form-group">
                <label class="control-label">Categoría</label>
                <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.IdCategoria">
                    <option disabled selected value="">Seleccione una categoría</option>
                </select>
                <span asp-validation-for="IdCategoria" class="text-danger"></span>
            </div>

            <input type="hidden" asp-for="UsuarioRegistro" />
            <input type="hidden" asp-for="FechaRegistro" />
            <input type="hidden" asp-for="Estado" />

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-floppy-disk"></i> Guardar
                </button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index"><i class="fa fa-arrow-left"></i> Volver a la lista</a>
</div>

<!-- MODAL NUEVA MARCA -->
<div class="modal fade" id="nuevaMarcaModal" tabindex="-1" aria-labelledby="nuevaMarcaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="nuevaMarcaModalLabel">Agregar Nueva Marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="text" id="nombreMarca" class="form-control" placeholder="Nombre de la marca" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="guardarMarcaBtn">Guardar Marca</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script>
        $(document).ready(function() {
            $('#guardarMarcaBtn').click(function () {
                var nombreMarca = $('#nombreMarca').val().trim();
                if(nombreMarca === "") {
                    alert("Ingrese un nombre para la marca.");
                    return;
                }

                $.ajax({
                    url: '@Url.Action("CreateAjax", "Marca")',
                    type: 'POST',
                    data: { nombre: nombreMarca },
                    success: function(response) {
                        if(response.success) {
                            var nuevaOpcion = new Option(response.nombre, response.id, true, true);
                            $('#IdMarca').append(nuevaOpcion);
                            $('#nuevaMarcaModal').modal('hide');
                            $('#nombreMarca').val('');
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert("Ocurrió un error al guardar la marca.");
                    }
                });
            });
        });
    </script>
}
