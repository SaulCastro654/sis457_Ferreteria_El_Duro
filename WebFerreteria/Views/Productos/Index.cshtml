@model IEnumerable<WebFerreteria.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<h1>Productos</h1>

<!-- Buscador -->
<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Buscar producto por nombre...">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fa fa-search"></i> Buscar
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                {
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fa fa-times"></i> Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus"></i> Crear Nuevo
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
{
    <div class="alert alert-info mb-3">
        <i class="fa fa-info-circle"></i> Mostrando resultados para: <strong>"@ViewData["CurrentFilter"]"</strong>
        <a asp-action="Index" class="float-end">Ver todos los productos</a>
    </div>
}

<div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark position-sticky top-0">
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Cantidad Medida</th>
                <th>Fecha Vencimiento</th>
                <th>Marca</th>
                <th>Categoría</th>
                <th>Usuario Registro</th>
                <th>Fecha Registro</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Precio</td>
                        <td>@item.Stock</td>
                        <td>@item.CantidadMedida</td>
                        <td>@item.FechaVencimiento?.ToString("dd/MM/yyyy")</td>
                        <td>@item.IdMarcaNavigation?.Nombre</td>
                        <td>@item.IdCategoriaNavigation?.Nombre</td>
                        <td>@item.UsuarioRegistro</td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Ver detalles">
                                <i class="fa fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="10" class="text-center text-muted py-4">
                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                        {
                            <i class="fa fa-search fa-2x mb-3"></i>
                            <br>
                            <span>No se encontraron productos con el nombre "<strong>@ViewData["CurrentFilter"]</strong>"</span>
                            <br>
                            <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Ver todos los productos</a>
                        }
                        else
                        {
                            <i class="fa fa-box fa-2x mb-3"></i>
                            <br>
                            <span>No hay productos registrados</span>
                            <br>
                            <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                                <i class="fa fa-plus"></i> Agregar primer producto
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>