@model WebFerreteria.Models.Producto

@{
    ViewData["Title"] = "Detalle de Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Estilos específicos para la página de detalles -->
<style>
    .details-container {
        background: url('/images/banner1.jpg') no-repeat center center fixed;
        background-size: cover;
        min-height: calc(100vh - 140px);
        padding: 40px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .details-content {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        width: 100%;
        max-width: 800px;
        margin: 20px;
    }

    .details-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f3cf2d;
    }

        .details-header h1 {
            color: #212120;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .details-header .subtitle {
            color: #666;
            font-size: 1.1rem;
        }

    .info-card {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #f3cf2d;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-item {
        margin-bottom: 20px;
    }

    .info-label {
        font-weight: 600;
        color: #212120;
        margin-bottom: 5px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 1.1rem;
        color: #333;
        font-weight: 500;
        padding: 8px 0;
    }

    .badge-status {
        font-size: 0.9rem;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .actions-section {
        text-align: center;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e0e0e0;
    }

    .btn-edit {
        background: linear-gradient(135deg, #212120 0%, #2c2c2c 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 15px;
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 207, 45, 0.3);
            color: #212120;
        }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
            color: white;
        }

    .stock-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .stock-high {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .stock-medium {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeaa7;
    }

    .stock-low {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .price-display {
        font-size: 1.3rem;
        font-weight: bold;
        color: #28a745;
        background: #f8f9fa;
        padding: 8px 15px;
        border-radius: 10px;
        border: 2px solid #e9ecef;
    }

    /* Media query corregida */
    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .details-content {
            padding: 25px;
            margin: 15px;
        }

        .actions-section {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .btn-edit, .btn-back {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="details-container">
    <div class="details-content">
        <!-- Encabezado -->
        <div class="details-header">
            <h1><i class="fas fa-box me-2"></i>Detalle de Producto</h1>
            <div class="subtitle">Información completa del producto</div>
        </div>

        <!-- Información Principal -->
        <div class="info-card">
            <div class="info-grid">
                <!-- Nombre -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-tag me-2"></i>Nombre del Producto
                    </div>
                    <div class="info-value">@Model.Nombre</div>
                </div>

                <!-- Precio -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-dollar-sign me-2"></i>Precio
                    </div>
                    <div class="price-display">
                        @{
                            // Corregido: No usar ? en decimal
                            var precioFormateado = Model.Precio.ToString("C2");
                        }
                        @precioFormateado
                    </div>
                </div>

                <!-- Stock -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-boxes me-2"></i>Stock Disponible
                    </div>
                    <div class="info-value">
                        @{
                            var stockClass = Model.Stock > 20 ? "stock-high" :
                            Model.Stock > 5 ? "stock-medium" : "stock-low";
                            var stockIcon = Model.Stock > 20 ? "fa-check" :
                            Model.Stock > 5 ? "fa-exclamation" : "fa-exclamation-triangle";
                        }
                        <span class="stock-indicator @stockClass">
                            <i class="fas @stockIcon"></i>
                            @Model.Stock unidades
                        </span>
                    </div>
                </div>

                <!-- Cantidad Medida -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-ruler me-2"></i>Cantidad de Medida
                    </div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.CantidadMedida))
                        {
                            @Model.CantidadMedida
                        }
                        else
                        {
                            <span class="text-muted">No especificado</span>
                        }
                    </div>
                </div>

                <!-- Fecha Vencimiento -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-calendar-alt me-2"></i>Fecha de Vencimiento
                    </div>
                    <div class="info-value">
                        @if (Model.FechaVencimiento.HasValue)
                        {
                            // SOLUCIÓN: Usar DateOnly directamente
                            var vencimiento = Model.FechaVencimiento.Value;
                            var hoy = DateOnly.FromDateTime(DateTime.Today);
                            var diasRestantes = vencimiento.DayNumber - hoy.DayNumber;

                            <span>@vencimiento.ToString("dd/MM/yyyy")</span>
                            @if (diasRestantes < 30 && diasRestantes >= 0)
                            {
                                <span class="badge bg-warning ms-2">Vence en @diasRestantes días</span>
                            }
                            else if (diasRestantes < 0)
                            {
                                <span class="badge bg-danger ms-2">Vencido</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-2">Vigente</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted">No aplica</span>
                        }
                    </div>
                </div>

                <!-- Estado -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-circle me-2"></i>Estado
                    </div>
                    <div class="info-value">
                        <span class="badge @(Model.Estado == 1 ? "bg-success" : "bg-secondary") badge-status">
                            @(Model.Estado == 1 ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Categorización -->
        <div class="info-card">
            <h5 class="mb-3" style="color: #212120;">
                <i class="fas fa-folder me-2"></i>Información de Categorización
            </h5>
            <div class="info-grid">
                <!-- Marca -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-tags me-2"></i>Marca
                    </div>
                    <div class="info-value">
                        @if (Model.IdMarcaNavigation != null)
                        {
                            <span class="badge bg-secondary">@Model.IdMarcaNavigation.Nombre</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin marca</span>
                        }
                    </div>
                </div>

                <!-- Categoría -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-layer-group me-2"></i>Categoría
                    </div>
                    <div class="info-value">
                        @if (Model.IdCategoriaNavigation != null)
                        {
                            <span class="badge bg-info">@Model.IdCategoriaNavigation.Nombre</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin categoría</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Auditoría -->
        <div class="info-card">
            <h5 class="mb-3" style="color: #212120;">
                <i class="fas fa-history me-2"></i>Información de Registro
            </h5>
            <div class="info-grid">
                <!-- Usuario Registro -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-user me-2"></i>Usuario Registro
                    </div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.UsuarioRegistro))
                        {
                            @Model.UsuarioRegistro
                        }
                        else
                        {
                            <span class="text-muted">No especificado</span>
                        }
                    </div>
                </div>

                <!-- Fecha Registro -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-calendar me-2"></i>Fecha Registro
                    </div>
                    <div class="info-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="actions-section">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
                <i class="fas fa-edit"></i> Editar Producto
            </a>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i> Volver a la Lista
            </a>
        </div>
    </div>
</div>