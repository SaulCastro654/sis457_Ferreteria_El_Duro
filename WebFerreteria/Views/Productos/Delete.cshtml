@model WebFerreteria.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Estilos específicos para la página de eliminación -->
<style>
    .delete-container {
        background: url('/images/banner1.jpg') no-repeat center center fixed;
        background-size: cover;
        min-height: calc(100vh - 140px);
        padding: 40px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .delete-content {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        width: 100%;
        max-width: 800px;
        margin: 20px;
    }

    .delete-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #dc3545;
    }

        .delete-header h1 {
            color: #dc3545;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

    .warning-alert {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        border: 2px solid #dc3545;
        border-radius: 15px;
        padding: 20px;
        margin-bottom: 30px;
        text-align: center;
    }

        .warning-alert i {
            font-size: 2rem;
            color: #dc3545;
            margin-bottom: 15px;
        }

        .warning-alert h3 {
            color: #721c24;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .warning-alert p {
            color: #721c24;
            margin: 0;
            font-weight: 500;
        }

    .info-card {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 25px;
        border-left: 4px solid #dc3545;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .info-item {
        margin-bottom: 20px;
    }

    .info-label {
        font-weight: 600;
        color: #212120;
        margin-bottom: 5px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 1.1rem;
        color: #333;
        font-weight: 500;
        padding: 8px 0;
    }

    .badge-status {
        font-size: 0.9rem;
        padding: 6px 12px;
        border-radius: 20px;
    }

    .actions-section {
        text-align: center;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e0e0e0;
    }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 15px;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
            color: white;
        }

    .btn-cancel {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-cancel:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
            color: white;
        }

    .stock-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 600;
    }

    .stock-high {
        background: #d4edda;
        color: #155724;
        border: 1px solid #c3e6cb;
    }

    .stock-medium {
        background: #fff3cd;
        color: #856404;
        border: 1px solid #ffeaa7;
    }

    .stock-low {
        background: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c6cb;
    }

    .price-display {
        font-size: 1.3rem;
        font-weight: bold;
        color: #28a745;
        background: #f8f9fa;
        padding: 8px 15px;
        border-radius: 10px;
        border: 2px solid #e9ecef;
    }

    .consequences-warning {
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 10px;
        padding: 15px;
        margin-top: 20px;
    }

        .consequences-warning h6 {
            color: #856404;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .consequences-warning ul {
            color: #856404;
            margin: 0;
            padding-left: 20px;
        }

        .consequences-warning li {
            margin-bottom: 5px;
        }

    /* Media query corregida */
    @@media (max-width: 768px) {
        .info-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .delete-content {
            padding: 25px;
            margin: 15px;
        }

        .actions-section {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .btn-delete, .btn-cancel {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="delete-container">
    <div class="delete-content">
        <!-- Encabezado -->
        <div class="delete-header">
            <h1><i class="fas fa-trash-alt me-2"></i>Eliminar Producto</h1>
        </div>

        <!-- Alerta de advertencia -->
        <div class="warning-alert">
            <i class="fas fa-exclamation-triangle"></i>
            <h3>¡Advertencia: Acción irreversible!</h3>
            <p>Está a punto de eliminar permanentemente este producto del sistema.</p>
        </div>

        <!-- Información del Producto a Eliminar -->
        <div class="info-card">
            <h5 class="mb-3" style="color: #dc3545;">
                <i class="fas fa-box me-2"></i>Producto a Eliminar
            </h5>
            <div class="info-grid">
                <!-- Nombre -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-tag me-2"></i>Nombre del Producto
                    </div>
                    <div class="info-value">@Model.Nombre</div>
                </div>

                <!-- Precio -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-dollar-sign me-2"></i>Precio
                    </div>
                    <div class="price-display">
                        @{
                            // CORREGIDO: Eliminar el ? porque decimal no es nullable
                            var precioFormateado = Model.Precio.ToString("C2");
                        }
                        @precioFormateado
                    </div>
                </div>

                <!-- Stock -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-boxes me-2"></i>Stock Disponible
                    </div>
                    <div class="info-value">
                        @{
                            var stockClass = Model.Stock > 20 ? "stock-high" :
                            Model.Stock > 5 ? "stock-medium" : "stock-low";
                            var stockIcon = Model.Stock > 20 ? "fa-check" :
                            Model.Stock > 5 ? "fa-exclamation" : "fa-exclamation-triangle";
                        }
                        <span class="stock-indicator @stockClass">
                            <i class="fas @stockIcon"></i>
                            @Model.Stock unidades
                        </span>
                    </div>
                </div>

                <!-- Cantidad Medida -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-ruler me-2"></i>Cantidad de Medida
                    </div>
                    <div class="info-value">
                        @if (!string.IsNullOrEmpty(Model.CantidadMedida))
                        {
                            @Model.CantidadMedida
                        }
                        else
                        {
                            <span class="text-muted">No especificado</span>
                        }
                    </div>
                </div>

                <!-- Fecha Vencimiento -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-calendar-alt me-2"></i>Fecha de Vencimiento
                    </div>
                    <div class="info-value">
                        @if (Model.FechaVencimiento.HasValue)
                        {
                            @Model.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span class="text-muted">No aplica</span>
                        }
                    </div>
                </div>

                <!-- Estado -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-circle me-2"></i>Estado Actual
                    </div>
                    <div class="info-value">
                        <span class="badge @(Model.Estado == 1 ? "bg-success" : "bg-secondary") badge-status">
                            @(Model.Estado == 1 ? "Activo" : "Inactivo")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información de Categorización -->
        <div class="info-card">
            <h5 class="mb-3" style="color: #dc3545;">
                <i class="fas fa-folder me-2"></i>Información de Categorización
            </h5>
            <div class="info-grid">
                <!-- Marca -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-tags me-2"></i>Marca
                    </div>
                    <div class="info-value">
                        @if (Model.IdMarcaNavigation != null)
                        {
                            <span class="badge bg-secondary">@Model.IdMarcaNavigation.Nombre</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin marca</span>
                        }
                    </div>
                </div>

                <!-- Categoría -->
                <div class="info-item">
                    <div class="info-label">
                        <i class="fas fa-layer-group me-2"></i>Categoría
                    </div>
                    <div class="info-value">
                        @if (Model.IdCategoriaNavigation != null)
                        {
                            <span class="badge bg-info">@Model.IdCategoriaNavigation.Nombre</span>
                        }
                        else
                        {
                            <span class="text-muted">Sin categoría</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Advertencia de Consecuencias -->
        <div class="consequences-warning">
            <h6><i class="fas fa-exclamation-circle me-2"></i>Consecuencias de esta acción:</h6>
            <ul>
                <li>El producto será eliminado permanentemente de la base de datos</li>
                <li>No podrá recuperar la información del producto</li>
                <li>Si existen ventas asociadas a este producto, podrían verse afectadas</li>
                <li>Esta acción no se puede deshacer</li>
            </ul>
        </div>

        <!-- Formulario de Eliminación -->
        <form asp-action="Delete" id="deleteForm">
            <input type="hidden" asp-for="Id" />

            <!-- Botones de Acción -->
            <div class="actions-section">
                <button type="submit" class="btn-delete" onclick="return confirmDelete()">
                    <i class="fas fa-trash-alt"></i> Confirmar Eliminación
                </button>
                <a asp-action="Index" class="btn-cancel">
                    <i class="fas fa-times"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete() {
            const productName = '@Model.Nombre';
            return confirm(`¿ESTÁ ABSOLUTAMENTE SEGURO que desea eliminar el producto "${productName}"?\n\n Esta acción es permanente y no se puede deshacer.`);
        }

        // Prevenir envío accidental del formulario
        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            const productName = '@Model.Nombre';
            if (!confirm(`¿CONFIRMA LA ELIMINACIÓN del producto "${productName}"?`)) {
                e.preventDefault();
            }
        });

        // Prevenir envío con Enter
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
            }
        });
    </script>
}