@model IEnumerable<WebFerreteria.Models.Venta>
@{
    ViewData["Title"] = "Ventas";
}

<h2>Ventas</h2>

<!-- Buscador -->
<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Buscar ventas por nombre del cliente...">
                <button class="btn btn-outline-secondary" type="submit">
                    <i class="fa fa-search"></i> Buscar
                </button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                {
                    <a asp-action="Index" class="btn btn-outline-danger">
                        <i class="fa fa-times"></i> Limpiar
                    </a>
                }
            </div>
        </form>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa fa-plus-circle"></i> Nueva Venta
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
{
    <div class="alert alert-info mb-3">
        <i class="fa fa-info-circle"></i> Mostrando resultados para: <strong>"@ViewData["CurrentFilter"]"</strong>
        <a asp-action="Index" class="float-end">Ver todas las ventas</a>
    </div>
}

<div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark position-sticky top-0" style="z-index: 1;">
            <tr>
                <th>Cliente</th>
                <th>Usuario</th>
                <th>Total</th>
                <th>Tipo Entrega</th>
                <th>Fecha</th>
                <th width="120">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Any())
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdClienteNavigation?.Nombre</td>
                        <td>@item.IdUsuarioNavigation?.Nombre</td>
                        <td>@item.Total.ToString("N2") Bs.</td>
                        <td>@item.TipoEntrega</td>
                        <td>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="Ver detalles">
                                <i class="fa fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">
                        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                        {
                            <i class="fa fa-search fa-2x mb-3"></i>
                            <br>
                            <span>No se encontraron ventas para el cliente "<strong>@ViewData["CurrentFilter"]</strong>"</span>
                            <br>
                            <a asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">Ver todas las ventas</a>
                        }
                        else
                        {
                            <i class="fa fa-shopping-cart fa-2x mb-3"></i>
                            <br>
                            <span>No hay ventas registradas</span>
                            <br>
                            <a asp-action="Create" class="btn btn-primary btn-sm mt-2">
                                <i class="fa fa-plus-circle"></i> Crear primera venta
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />