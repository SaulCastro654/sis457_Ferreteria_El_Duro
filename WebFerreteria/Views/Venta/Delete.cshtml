@model WebFerreteria.Models.Venta

@{
    ViewData["Title"] = "Eliminar Venta";
}

<h2>Eliminar Venta</h2>
<hr />

<div class="alert alert-warning">
    <h5>¿Está seguro que desea eliminar esta venta?</h5>
    <p class="mb-0">Esta acción no se puede deshacer. Se realizará una eliminación lógica.</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Información de la Venta</h5>

        <dl class="row">
            <dt class="col-sm-3">Cliente:</dt>
            <dd class="col-sm-9">@Model.IdClienteNavigation?.Nombre</dd>

            <dt class="col-sm-3">Usuario:</dt>
            <dd class="col-sm-9">@Model.IdUsuarioNavigation?.Nombre</dd>

            <dt class="col-sm-3">Total:</dt>
            <dd class="col-sm-9">@Model.Total.ToString("Bs")</dd>

            <dt class="col-sm-3">Tipo de Entrega:</dt>
            <dd class="col-sm-9">@Model.TipoEntrega</dd>

            <dt class="col-sm-3">Fecha Registro:</dt>
            <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Usuario Registro:</dt>
            <dd class="col-sm-9">@Model.UsuarioRegistro</dd>

            <dt class="col-sm-3">Estado:</dt>
            <dd class="col-sm-9">
                @if (Model.Estado == 1)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        <i class="fa fa-trash"></i> Confirmar Eliminación
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Cancelar
    </a>
</form>