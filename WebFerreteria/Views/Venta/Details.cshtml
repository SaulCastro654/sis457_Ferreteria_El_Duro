@model WebFerreteria.Models.Venta

@{
    ViewData["Title"] = "Detalles de la Venta";
}

<h2>Detalles de la Venta</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">Información General</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">ID Venta:</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">Cliente:</dt>
                    <dd class="col-sm-8">@Model.IdClienteNavigation?.Nombre</dd>

                    <dt class="col-sm-4">Usuario:</dt>
                    <dd class="col-sm-8">@Model.IdUsuarioNavigation?.Nombre</dd>

                    <dt class="col-sm-4">Total:</dt>
                    <dd class="col-sm-8">@Model.Total.ToString("N2") Bs.</dd>

                    <dt class="col-sm-4">Tipo de Entrega:</dt>
                    <dd class="col-sm-8">@Model.TipoEntrega</dd>

                    <dt class="col-sm-4">Fecha Registro:</dt>
                    <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Usuario Registro:</dt>
                    <dd class="col-sm-8">@Model.UsuarioRegistro</dd>

                    <dt class="col-sm-4">Estado:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Estado == 1)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Detalles de Productos</h5>
            </div>
            <div class="card-body">
                @if (Model.DetalleVenta != null && Model.DetalleVenta.Any(d => d.Estado == 1))
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio Unit.</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in Model.DetalleVenta.Where(d => d.Estado == 1))
                                {
                                    var subtotal = detalle.Cantidad * detalle.PrecioUnitario;
                                    <tr>
                                        <td>@detalle.IdProductoNavigation?.Nombre</td>
                                        <td>@detalle.Cantidad</td>
                                        <td>@detalle.PrecioUnitario.ToString("N2") Bs.</td>
                                        <td>@subtotal.ToString("N2") Bs.</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-primary">
                                    <td colspan="3" class="text-end"><strong>Total:</strong></td>
                                    <td><strong>@Model.Total.ToString("N2") Bs.</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay detalles de productos registrados.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
        <i class="fa fa-edit"></i> Editar
    </a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
        <i class="fa fa-trash"></i> Eliminar
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Volver a la lista
    </a>
</div>