@model WebFerreteria.Models.Venta

@{
    ViewData["Title"] = "Detalles de la Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Estilos específicos para la vista de detalles -->
<style>
    .details-container {
        background: url('/images/banner1.jpg') no-repeat center center fixed;
        background-size: cover;
        min-height: calc(100vh - 140px);
        padding: 40px 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .details-content {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        width: 100%;
        max-width: 1200px;
        margin: 20px;
    }

    .details-header {
        text-align: center;
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 2px solid #f3cf2d;
    }

        .details-header h2 {
            color: #212120;
            font-size: 2.2rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .details-header .subtitle {
            color: #666;
            font-size: 1.1rem;
        }

    .info-card {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 25px;
        border-left: 4px solid #f3cf2d;
    }

    .info-item {
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #e9ecef;
    }

        .info-item:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

    .info-label {
        font-weight: 600;
        color: #212120;
        margin-bottom: 8px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 1.2rem;
        color: #333;
        font-weight: 500;
    }

    .badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .bg-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
    }

    .bg-info {
        background: linear-gradient(135deg, #17a2b8 0%, #138496 100%) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg, #ffc107 0%, #fd7e14 100%) !important;
    }

    .actions-section {
        text-align: center;
        margin-top: 30px;
        padding-top: 25px;
        border-top: 1px solid #e0e0e0;
    }

    .btn-edit {
        background: linear-gradient(135deg, #212120 0%, #2c2c2c 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 30px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 15px;
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 207, 45, 0.3);
            color: #212120;
        }

    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-right: 15px;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #c82333 0%, #a71e2a 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
        }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        border: none;
        border-radius: 10px;
        padding: 12px 25px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .btn-back:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
        }

    /* Tabla mejorada */
    .table {
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 0;
    }

        .table thead th {
            background: linear-gradient(135deg, #212120 0%, #2c2c2c 100%);
            color: white;
            border: none;
            padding: 15px 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.85rem;
        }

        .table tbody td {
            padding: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #e9ecef;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background-color: rgba(243, 207, 45, 0.1);
            }

    .table-primary {
        background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
    }

        .table-primary td {
            color: #212120;
            font-weight: 600;
            border: none;
        }

    .venta-icon {
        font-size: 4rem;
        color: #f3cf2d;
        margin-bottom: 20px;
    }

    .total-amount {
        font-size: 1.5rem;
        font-weight: bold;
        color: #28a745;
    }

    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 15px;
            opacity: 0.7;
        }

    @@media (max-width: 768px) {
        .details-content {
            padding: 25px;
            margin: 15px;
        }

        .actions-section {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .btn-edit, .btn-delete, .btn-back {
            width: 100%;
            justify-content: center;
            margin-right: 0;
        }

        .info-card {
            padding: 20px;
        }
    }
</style>

<div class="details-container">
    <div class="details-content">
        <!-- Encabezado -->
        <div class="details-header">
            <div class="venta-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <h2>Detalles de la Venta</h2>
            <div class="subtitle">Información completa de la venta registrada</div>
        </div>

        <div class="row">
            <!-- Información General -->
            <div class="col-md-6">
                <div class="info-card">
                    <h5 class="mb-4">
                        <i class="fas fa-info-circle me-2"></i>Información General
                    </h5>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-hashtag me-2"></i>ID de Venta
                        </div>
                        <div class="info-value">@Model.Id</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-user me-2"></i>Cliente
                        </div>
                        <div class="info-value">@Model.IdClienteNavigation?.Nombre</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-user-tag me-2"></i>Vendedor
                        </div>
                        <div class="info-value">@Model.IdUsuarioNavigation?.Nombre</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-dollar-sign me-2"></i>Total de Venta
                        </div>
                        <div class="info-value total-amount">@Model.Total.ToString("N2") Bs.</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-truck me-2"></i>Tipo de Entrega
                        </div>
                        <div class="info-value">
                            @if (Model.TipoEntrega == "A domicilio")
                            {
                                <span class="badge bg-warning">
                                    <i class="fas fa-truck me-1"></i>@Model.TipoEntrega
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info">
                                    <i class="fas fa-store me-1"></i>@Model.TipoEntrega
                                </span>
                            }
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-calendar me-2"></i>Fecha de Registro
                        </div>
                        <div class="info-value">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-user-check me-2"></i>Usuario Registro
                        </div>
                        <div class="info-value">
                            <span class="badge bg-info">@Model.UsuarioRegistro</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">
                            <i class="fas fa-circle me-2"></i>Estado
                        </div>
                        <div class="info-value">
                            @if (Model.Estado == 1)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="fas fa-times-circle me-1"></i>Inactivo
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detalles de Productos -->
            <div class="col-md-6">
                <div class="info-card">
                    <h5 class="mb-4">
                        <i class="fas fa-boxes me-2"></i>Detalles de Productos
                    </h5>

                    @if (Model.DetalleVenta != null && Model.DetalleVenta.Any(d => d.Estado == 1))
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th width="100">Cantidad</th>
                                        <th width="120">Precio Unit.</th>
                                        <th width="120">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model.DetalleVenta.Where(d => d.Estado == 1))
                                    {
                                        var subtotal = detalle.Cantidad * detalle.PrecioUnitario;
                                        <tr>
                                            <td>
                                                <strong>@detalle.IdProductoNavigation?.Nombre</strong>
                                                <!-- Se eliminó la referencia a Marca que causaba el error -->
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@detalle.Cantidad</span>
                                            </td>
                                            <td>@detalle.PrecioUnitario.ToString("N2") Bs.</td>
                                            <td><strong>@subtotal.ToString("N2") Bs.</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-primary">
                                        <td colspan="3" class="text-end"><strong>Total General:</strong></td>
                                        <td><strong class="total-amount">@Model.Total.ToString("N2") Bs.</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fas fa-box-open"></i>
                            <h5>No hay detalles de productos</h5>
                            <p>No se encontraron productos registrados para esta venta</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="actions-section">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-edit">
                <i class="fas fa-edit"></i> Editar Venta
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn-delete">
                <i class="fas fa-trash"></i> Eliminar Venta
            </a>
            <a asp-action="Index" class="btn-back">
                <i class="fas fa-arrow-left"></i> Volver al Listado
            </a>
        </div>
    </div>
</div>