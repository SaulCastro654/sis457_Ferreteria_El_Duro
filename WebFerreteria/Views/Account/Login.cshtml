@model LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    // Se mantiene el Layout si es correcto para tu proyecto
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">

    <div class="card shadow-lg p-3 mb-5 bg-white rounded" style="width: 100%; max-width: 400px;">
        <div class="card-header bg-primary text-white text-center">
            <h4 class="mb-0">🔑 Iniciar Sesión</h4>
        </div>
        <div class="card-body">

            <form asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" role="form">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-group mb-3">
                    <label asp-for="Usuario" class="form-label"></label>
                    <input asp-for="Usuario" class="form-control" placeholder="Ingresa tu usuario" required />
                    <span asp-validation-for="Usuario" class="text-danger"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Clave" class="form-label"></label>
                    <input asp-for="Clave" type="password" class="form-control" placeholder="Ingresa tu contraseña" required />
                    <span asp-validation-for="Clave" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    

                    <input type="submit" value="Iniciar Sesión" class="btn btn-primary btn-lg" />
                </div>
            </form>
        </div>

        <div class="card-footer text-center">
            <div class="mb-2">
                <a asp-controller="Account" asp-action="ResetPassword" class="text-secondary">¿Olvidaste tu contraseña?</a>
            </div>
            <div>
                <a asp-controller="Account" asp-action="Register" class="text-primary">¿No tienes cuenta? Regístrate</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}