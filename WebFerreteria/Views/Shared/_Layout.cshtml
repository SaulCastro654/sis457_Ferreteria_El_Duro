<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebFerreteria</title>

    <!-- FAVICON CORREGIDO - Rutas correctas -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/logo.ico")">
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/logo.ico")">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Estilos del tema -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />

    <!-- Estilos de la aplicación -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Estructura flexbox para footer -->
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .container-fluid {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }
    </style>

    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="full_bg">
        <!-- Navbar Mejorado -->
        <nav class="navbar navbar-expand-lg navbar-improved">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/NLogo.png" alt="Ferretería El Duro" width="110" height="110">
                </a>

                <button class="navbar-toggler navbar-toggler-improved" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-2"></i>Inicio
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Action"]?.ToString() == "Privacy" ? "active" : "")"
                               asp-controller="Home" asp-action="Privacy">
                                <i class="fas fa-users me-2"></i>Nosotros
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == false)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")"
                                   asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Productos" ? "active" : "")"
                                   asp-controller="Productos" asp-action="Index">
                                    <i class="fas fa-boxes me-2"></i>Productos
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Marca" ? "active" : "")"
                                   asp-controller="Marca" asp-action="Index">
                                    <i class="fas fa-tags me-2"></i>Marcas
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cliente" ? "active" : "")"
                                   asp-controller="Cliente" asp-action="Index">
                                    <i class="fas fa-users me-2"></i>Clientes
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-improved @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Venta" ? "active" : "")"
                                   asp-controller="Venta" asp-action="Index">
                                    <i class="fas fa-shopping-cart me-2"></i>Ventas
                                </a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-link-improved user-welcome dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle me-2"></i>@User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-improved dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item dropdown-item-improved logout-btn">
                                                <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>

        <!-- Banner Solo para Home - CORREGIDO -->
        @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
        {
            <section class="banner_main">
                <div id="myCarousel" class="carousel slide banner" data-ride="carousel">
                    <ol class="carousel-indicators">
                        <li data-target="#myCarousel" data-slide-to="0" class="active"></li>
                        <li data-target="#myCarousel" data-slide-to="1"></li>
                        <li data-target="#myCarousel" data-slide-to="2"></li>
                    </ol>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <div class="container">
                                <div class="carousel-caption banner_po">
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="build_box text_align_left">
                                                <h1>BIENVENIDO A:<br> <span class="white">FERRETERIA EL DURO</span></h1>
                                                <p>En <strong>Ferretería El Duro</strong> nos especializamos en proveer herramientas de calidad, materiales de construcción y todo lo necesario para sus proyectos. Contamos con asesoramiento técnico profesional y un amplio stock permanente para satisfacer todas sus necesidades.</p>
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <a class="read_more conatct_btn" asp-controller="Venta" asp-action="Index" role="button">VER VENTAS</a>
                                                    <a class="read_more conatct_btn" asp-controller="Productos" asp-action="Index" role="button">VER PRODUCTOS</a>
                                                }
                                                else
                                                {
                                                    <a class="read_more conatct_btn" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Venta")" role="button">VER VENTAS</a>
                                                    <a class="read_more conatct_btn" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Productos")" role="button">VER PRODUCTOS</a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <strong>best</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    </header>

    <!-- Contenido Principal -->
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer">
            <div class="container">
                <div class="col-md-10 offset-md-1">
                    <ul class="conta">
                        <li><i class="fa fa-volume-control-phone" aria-hidden="true"></i> +591 73425830</li>
                        <li> <i class="fa fa-envelope" aria-hidden="true"></i><a href="#"> elduro@gmail.com</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyright">
                <div class="container">
                    <div class="row">
                        <div class="col-md-10 offset-md-1">
                            <p>Copyright 2025 All Right Reserved By <a href="#">Ferreteria El Duro</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>