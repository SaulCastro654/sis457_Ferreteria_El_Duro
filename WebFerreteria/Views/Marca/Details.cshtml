@model WebFerreteria.Models.Marca

<h2>Detalles de Marca</h2>

<div class="card p-3">
    <p><strong>Nombre:</strong> @Model.Nombre</p>
    <p><strong>Fecha Registro:</strong> @Model.FechaRegistro</p>
    <p><strong>Usuario Registro:</strong> @Model.UsuarioRegistro</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning mt-3">Editar</a>
<a asp-action="Index" class="btn btn-secondary mt-3">Volver</a>
