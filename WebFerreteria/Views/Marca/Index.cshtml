@model IEnumerable<WebFerreteria.Models.Marca>
@{
    ViewData["Title"] = "Marcas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Estilos específicos para la página de marcas -->
<style>
    .marcas-container {
        background: url('/images/banner1.jpg') no-repeat center center fixed;
        background-size: cover;
        min-height: calc(100vh - 140px);
        padding: 40px 0;
    }

    .marcas-content {
        background: rgba(255, 255, 255, 0.98);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 0 15px 50px rgba(0,0,0,0.15);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        margin: 0 auto;
        max-width: 1200px;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        padding-bottom: 25px;
        border-bottom: 2px solid #f3cf2d;
    }

        .page-header h2 {
            color: #212120;
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .page-header .subtitle {
            color: #666;
            font-size: 1.1rem;
        }

    .search-section {
        background: #f8f9fa;
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        border-left: 4px solid #f3cf2d;
    }

    .btn-primary {
        background: linear-gradient(135deg, #212120 0%, #2c2c2c 100%);
        border: none;
        border-radius: 10px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(243, 207, 45, 0.3);
            color: #212120;
        }

    .btn-outline-secondary {
        border: 2px solid #6c757d;
        border-radius: 8px;
        color: #6c757d;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-secondary:hover {
            background: #6c757d;
            color: white;
            transform: translateY(-2px);
        }

    .btn-outline-danger {
        border: 2px solid #dc3545;
        border-radius: 8px;
        color: #dc3545;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-danger:hover {
            background: #dc3545;
            color: white;
            transform: translateY(-2px);
        }

    .table-container {
        max-height: 600px;
        overflow-y: auto;
        border: 1px solid #e0e0e0;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        background: white;
    }

    .table {
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            background: linear-gradient(135deg, #212120 0%, #2c2c2c 100%);
            color: white;
            position: sticky;
            top: 0;
            z-index: 10;
            border: none;
            padding: 15px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table tbody td {
            padding: 12px 15px;
            vertical-align: middle;
            border-bottom: 1px solid #e9ecef;
        }

        .table tbody tr {
            transition: all 0.3s ease;
        }

            .table tbody tr:hover {
                background-color: rgba(243, 207, 45, 0.1);
                transform: translateY(-1px);
                box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            }

    /* BOTONES DE ACCIONES MEJORADOS - COLORES ESPECÍFICOS */
    .action-buttons {
        display: flex;
        gap: 8px;
        justify-content: center;
        align-items: center;
    }

    .btn-action {
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        position: relative;
        overflow: hidden;
    }

        .btn-action::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            transition: left 0.5s;
        }

        .btn-action:hover::before {
            left: 100%;
        }

        .btn-action:hover {
            transform: translateY(-3px) scale(1.1);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

    /* VIEW: Fondo negro, logo blanco */
    .btn-details {
        background: linear-gradient(135deg, #212120 0%, #000000 100%);
        color: white;
        border: 1px solid #333;
    }

        .btn-details:hover {
            background: linear-gradient(135deg, #000000 0%, #212120 100%);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
            color: white;
        }

    /* EDIT: Fondo amarillo, logo negro */
    .btn-edit {
        background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
        color: #212120;
        border: 1px solid #d4b820;
    }

        .btn-edit:hover {
            background: linear-gradient(135deg, #e6c229 0%, #d4b820 100%);
            box-shadow: 0 5px 15px rgba(243, 207, 45, 0.4);
            color: #212120;
        }

    /* DELETE: Fondo rojo, logo negro */
    .btn-delete {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: #212120;
        border: 1px solid #bd2130;
    }

        .btn-delete:hover {
            background: linear-gradient(135deg, #c82333 0%, #bd2130 100%);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
            color: #212120;
        }

    /* Tooltips para los botones */
    .btn-action {
        position: relative;
    }

        .btn-action::after {
            content: attr(title);
            position: absolute;
            bottom: -40px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.75rem;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .btn-action:hover::after {
            opacity: 1;
            visibility: visible;
            bottom: -35px;
        }

    /* Efecto de pulso en hover CORREGIDO */
    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    .btn-action:active {
        animation: pulse 0.3s ease;
    }

    .alert-info {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        border: 2px solid #17a2b8;
        border-radius: 10px;
        color: #0c5460;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 4rem;
            color: #6c757d;
            margin-bottom: 20px;
            opacity: 0.7;
        }

        .empty-state h4 {
            color: #495057;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .empty-state p {
            color: #6c757d;
            margin-bottom: 25px;
        }

    .stats-card {
        background: linear-gradient(135deg, #f3cf2d 0%, #e6c229 100%);
        border-radius: 12px;
        padding: 20px;
        color: #212120;
        text-align: center;
        margin-bottom: 25px;
    }

    .stats-number {
        font-size: 2.5rem;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .stats-label {
        font-size: 1rem;
        font-weight: 600;
        opacity: 0.9;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #f3cf2d;
            box-shadow: 0 0 0 0.2rem rgba(243, 207, 45, 0.25);
        }

    /* Media queries */
    @@media (max-width: 768px) {
        .marcas-content {
            padding: 25px;
            margin: 15px;
        }

        .search-section {
            padding: 20px;
        }

        .table-container {
            max-height: 500px;
        }

        .action-buttons {
            gap: 5px;
        }

        .btn-action {
            width: 35px;
            height: 35px;
            font-size: 0.8rem;
        }

            .btn-action::after {
                font-size: 0.7rem;
                padding: 4px 8px;
            }
    }

    @@media (max-width: 576px) {
        .action-buttons {
            flex-direction: column;
            gap: 3px;
        }

        .btn-action {
            width: 32px;
            height: 32px;
        }
    }
</style>

<div class="marcas-container">
    <div class="marcas-content">
        <!-- Encabezado -->
        <div class="page-header">
            <h2><i class="fas fa-tags me-3"></i>Gestión de Marcas</h2>
            <div class="subtitle">Administre las marcas de productos disponibles en el sistema</div>
        </div>

        <!-- Tarjeta de estadísticas -->
        <div class="stats-card">
            <div class="stats-number">@Model.Count()</div>
            <div class="stats-label">Marcas Registradas</div>
        </div>

        <!-- Sección de búsqueda -->
        <div class="search-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <form asp-action="Index" method="get">
                        <div class="input-group">
                            <input type="text" class="form-control" name="searchString"
                                   value="@ViewData["CurrentFilter"]"
                                   placeholder="Buscar marca por nombre...">
                            <button class="btn btn-outline-secondary" type="submit">
                                <i class="fas fa-search me-2"></i>Buscar
                            </button>
                            @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                            {
                                <a asp-action="Index" class="btn btn-outline-danger">
                                    <i class="fas fa-times me-2"></i>Limpiar
                                </a>
                            }
                        </div>
                    </form>
                </div>
                <div class="col-md-4 text-end">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus-circle me-2"></i>Nueva Marca
                    </a>
                </div>
            </div>
        </div>

        <!-- Alerta de búsqueda -->
        @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
        {
            <div class="alert alert-info mb-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-info-circle me-2"></i>
                        Mostrando resultados para: <strong>"@ViewData["CurrentFilter"]"</strong>
                    </div>
                    <a asp-action="Index" class="btn btn-sm btn-outline-info">
                        <i class="fas fa-list me-1"></i>Ver todas las marcas
                    </a>
                </div>
            </div>
        }

        <!-- Tabla de marcas -->
        <div class="table-container">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th width="40%">Nombre de la Marca</th>
                        <th width="25%">Fecha Registro</th>
                        <th width="20%">Usuario</th>
                        <th width="15%" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Nombre</strong>
                                </td>
                                <td>
                                    <span class="text-muted">
                                        <i class="fas fa-calendar me-2"></i>@item.FechaRegistro.ToString("dd/MM/yyyy")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-user me-1"></i>@item.UsuarioRegistro
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn-action btn-details"
                                           title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn-action btn-edit"
                                           title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn-action btn-delete"
                                           title="Eliminar">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                <div class="empty-state">
                                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                                    {
                                        <i class="fas fa-search fa-3x mb-3"></i>
                                        <h4>No se encontraron marcas</h4>
                                        <p>No hay resultados para "<strong>@ViewData["CurrentFilter"]</strong>"</p>
                                        <a asp-action="Index" class="btn btn-primary">
                                            <i class="fas fa-list me-2"></i>Ver todas las marcas
                                        </a>
                                    }
                                    else
                                    {
                                        <i class="fas fa-tags fa-3x mb-3"></i>
                                        <h4>No hay marcas registradas</h4>
                                        <p>Comience agregando la primera marca al sistema</p>
                                        <a asp-action="Create" class="btn btn-primary">
                                            <i class="fas fa-plus-circle me-2"></i>Agregar primera marca
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Información del pie -->
        @if (Model.Any())
        {
            <div class="mt-3 text-muted">
                <small>
                    <i class="fas fa-chart-bar me-1"></i>
                    Total de marcas: <strong>@Model.Count()</strong>
                    @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"] as string))
                    {
                        <span class="ms-2">| Búsqueda: "@ViewData["CurrentFilter"]"</span>
                    }
                </small>
            </div>
        }
    </div>
</div>