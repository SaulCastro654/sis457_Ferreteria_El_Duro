@model WebFerreteria.Models.Cliente

@{
    ViewData["Title"] = "Eliminar Cliente";
}

<h2>Eliminar Cliente</h2>
<hr />

<div class="alert alert-warning">
    <h5>¿Está seguro que desea eliminar este cliente?</h5>
    <p class="mb-0">Esta acción no se puede deshacer.</p>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Información del Cliente</h5>

        <dl class="row">
            <dt class="col-sm-3">Nombre:</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>

            <dt class="col-sm-3">Teléfono:</dt>
            <dd class="col-sm-9">@(Model.Telefono ?? "No especificado")</dd>

            <dt class="col-sm-3">Dirección:</dt>
            <dd class="col-sm-9">@(Model.Direccion ?? "No especificada")</dd>

            <dt class="col-sm-3">Fecha Registro:</dt>
            <dd class="col-sm-9">@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Usuario Registro:</dt>
            <dd class="col-sm-9">@Model.UsuarioRegistro</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        <i class="fa fa-trash"></i> Confirmar Eliminación
    </button>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa fa-arrow-left"></i> Cancelar
    </a>
</form>